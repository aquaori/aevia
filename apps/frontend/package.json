{
	"name": "@collaborative-whiteboard/frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"test": "npm run test:e2e:smoke",
		"test:e2e:health": "npx tsx tests/e2e/external/runner.ts --suite=harness-health --mode=headless",
		"test:e2e:smoke": "npx tsx tests/e2e/external/runner.ts --suite=correctness-smoke --mode=headless",
		"test:e2e:smoke:ci": "npx tsx tests/e2e/external/runner.ts --suite=correctness-smoke --mode=headless --reporter=json",
		"test:e2e": "npx tsx tests/e2e/external/runner.ts --suite=correctness-full --mode=headless",
		"benchmark:external": "npx tsx tests/e2e/external/runner.ts --suite=performance-external --mode=headless",
		"benchmark:external:ci": "npx tsx tests/e2e/external/runner.ts --suite=performance-external --mode=headless --reporter=json",
		"benchmark:external:json": "npx tsx tests/e2e/external/runner.ts --suite=performance-external --mode=headless --reporter=json",
		"benchmark:external:resilience": "npx tsx tests/e2e/external/runner.ts --suite=performance-external --case-set=resilience --mode=headless --reporter=json --matrix=false",
		"benchmark:external:boundary": "npx tsx tests/e2e/external/runner.ts --suite=performance-external --case-set=boundary --mode=headless --reporter=json --matrix=true",
		"benchmark:external:learn": "npx tsx tests/e2e/external/runner.ts --suite=performance-external --mode=headless --import-current-to-history=true",
		"benchmark:external:headed": "npx tsx tests/e2e/external/runner.ts --suite=performance-external --mode=headed",
		"benchmark:external:full": "npm run benchmark:external && npm run benchmark:external:headed",
		"benchmark:external:set-baseline": "npx tsx tests/e2e/external/runner.ts --action=set-baseline --suite=performance-external",
		"benchmark:external:import-history": "npx tsx tests/e2e/external/runner.ts --action=import-history --suite=performance-external"
	},
	"dependencies": {
		"@collaborative-whiteboard/shared": "0.0.0",
		"axios": "^1.13.3",
		"lucide-vue-next": "^0.563.0",
		"pinia": "^3.0.4",
		"pinia-plugin-persistedstate": "^4.7.1",
		"vue": "^3.5.24",
		"vue-router": "^4.6.4",
		"vue-sonner": "^2.0.9"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^24.10.1",
		"@types/pixelmatch": "^5.2.6",
		"@types/pngjs": "^6.0.5",
		"@types/uuid": "^10.0.0",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/tsconfig": "^0.8.1",
		"autoprefixer": "^10.4.23",
		"pixelmatch": "^7.1.0",
		"playwright": "^1.58.2",
		"pngjs": "^7.0.0",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"typescript": "~5.9.3",
		"uuid": "^13.0.0",
		"vite": "^7.2.4",
		"vue-tsc": "^3.1.4",
		"ws": "^8.19.0"
	}
}
