# Copy to .env.local and adjust for your setup.
#
# These defaults target a backend on the same machine. Change them when the
# backend is not on localhost — for example, to test from a phone on the same
# network, use that machine's LAN address instead of 127.0.0.1.
VITE_API_URL=http://127.0.0.1:4646
VITE_WS_URL=ws://127.0.0.1:4646/ws

# Resume a reconnect from the last applied roomSeq instead of re-downloading the
# page. Enabled by default; set to 0 to force a full re-init on every reconnect.
# VITE_ENABLE_DELTA_REPLAY=0
