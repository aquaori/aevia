{
  "name": "collaborative-whiteboard-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/frontend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace @collaborative-whiteboard/frontend",
    "dev:frontend:lan": "node scripts/dev-frontend.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace @collaborative-whiteboard/frontend",
    "build:backend": "node scripts/go.mjs build",
    "lint": "eslint .",
    "start": "node scripts/go.mjs start",
    "preview": "npm run preview --workspace @collaborative-whiteboard/frontend",
    "test": "tsx tests/run-system.ts",
    "test:system": "tsx tests/run-system.ts",
    "test:go": "node scripts/go.mjs test",
    "test:go:vet": "node scripts/go.mjs vet",
    "test:quick:suite": "vitest run --project shared-unit --project frontend-unit --project frontend-module --project harness-unit --reporter=json",
    "test:coverage": "vitest run --project shared-unit --project frontend-unit --project frontend-module --project harness-unit --coverage --reporter=json",
    "test:browser:suite": "vitest run --project frontend-browser --reporter=json",
    "test:unit": "vitest run --project shared-unit --project frontend-unit --reporter=json --outputFile=tests/reports/vitest/unit.json",
    "test:integration": "vitest run --project frontend-module --reporter=json --outputFile=tests/reports/vitest/integration.json",
    "test:browser": "vitest run --project frontend-browser --reporter=json --outputFile=tests/reports/vitest/browser.json",
    "test:bench": "vitest bench --project micro-bench --outputJson=tests/reports/vitest/bench.json",
    "test:e2e": "npm run test:e2e --workspace @collaborative-whiteboard/frontend",
    "test:e2e:smoke": "npm run test:e2e:smoke:ci --workspace @collaborative-whiteboard/frontend",
    "test:benchmark": "tsx tests/run-system.ts --profile=custom --yes --build=false --unit=false --integration=false --browser=false --smoke=false --benchmark=true --resilience=false --boundary=false --matrix=true",
    "test:doctor": "tsx tests/run-system.ts --doctor",
    "test:quick": "tsx tests/run-system.ts --profile=quick --yes",
    "test:replay": "tsx tests/run-system.ts --replay",
    "test:full": "tsx tests/run-system.ts --profile=full --yes",
    "benchmark:backend": "node scripts/benchmark-backend.mjs",
    "test:report": "tsx tests/report/aggregate.ts",
    "test:all:local": "tsx tests/run-system.ts --profile=standard --yes",
    "test:ci": "tsx tests/run-system.ts --profile=ci --yes",
    "test:smoke": "tsx tests/run-system.ts --profile=smoke --yes",
    "test:nightly": "tsx tests/run-system.ts --profile=nightly --yes",
    "test:single": "tsx tests/run-system.ts --profile=single --yes",
    "benchmark:ci": "npm run benchmark:external:ci --workspace @collaborative-whiteboard/frontend",
    "benchmark:boundary": "npm run benchmark:external:boundary --workspace @collaborative-whiteboard/frontend",
    "benchmark:nightly": "npm run test:bench && npm run benchmark:external:learn --workspace @collaborative-whiteboard/frontend",
    "test:perf": "npm run test:benchmark",
    "test:frontend": "npm run test --workspace @collaborative-whiteboard/frontend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "happy-dom": "^20.0.11",
    "playwright": "^1.58.2",
    "supertest": "^7.1.4",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
