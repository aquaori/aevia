  "divergences": [
    {
      "name": "duplicate-json-key",
      "expect": {
        "go": "reject",
        "frontend": "accept"
      },
      "reason": "The Go validator walks the raw JSON token stream and rejects duplicate keys (case-insensitive). The browser parser consumes JSON.parse output, where a duplicate key has already collapsed to the last value. This is deliberate defence in depth: catalog documents are produced by the Go server, never authored by the client, so the frontend relies on the server-side walk and only validates shape/semantics.",
      "rawManifest": "{\"manifestVersion\":1,\"id\":\"fixture.dup-key\",\"name\":\"One\",\"name\":\"Two\",\"version\":\"1.0.0\",\"scope\":\"system\",\"contributes\":{}}"
    }
  ]
