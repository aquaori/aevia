{
	"schemaVersion": 1,
	"description": "Cross-runtime ordering golden vectors. ASCII ids only: non-ASCII ids are excluded because the Go backend compares UTF-8 bytes while the frontend compares UTF-16 code units, and those orders are not guaranteed to agree. commands exercises compareCommandOrder (== domain.CompareFlatPoint with PointIndex 0); renderKeys exercises compareRenderOrder.",
	"commands": [
		{
			"labels": ["c3", "a1", "b2"],
			"expectedOrder": ["a1", "b2", "c3"],
			"items": [
				{"id": "c3", "lamport": 3},
				{"id": "a1", "lamport": 1},
				{"id": "b2", "lamport": 2}
			]
		},
		{
			"labels": ["bbb", "aaa", "ccc"],
			"expectedOrder": ["aaa", "bbb", "ccc"],
			"items": [
				{"id": "bbb", "lamport": 5},
				{"id": "aaa", "lamport": 5},
				{"id": "ccc", "lamport": 5}
			]
		},
		{
			"labels": ["b", "A", "a", "B"],
			"expectedOrder": ["A", "B", "a", "b"],
			"items": [
				{"id": "b", "lamport": 2},
				{"id": "A", "lamport": 2},
				{"id": "a", "lamport": 2},
				{"id": "B", "lamport": 2}
			]
		},
		{
			"labels": ["cmd-10", "cmd-2", "cmd-1"],
			"expectedOrder": ["cmd-1", "cmd-10", "cmd-2"],
			"items": [
				{"id": "cmd-10", "lamport": 7},
				{"id": "cmd-2", "lamport": 7},
				{"id": "cmd-1", "lamport": 7}
			]
		},
		{
			"labels": ["abc", "a", "ab"],
			"expectedOrder": ["a", "ab", "abc"],
			"items": [
				{"id": "abc", "lamport": 4},
				{"id": "a", "lamport": 4},
				{"id": "ab", "lamport": 4}
			]
		},
		{
			"labels": ["b", "z", "a", "y"],
			"expectedOrder": ["y", "z", "a", "b"],
			"items": [
				{"id": "b", "lamport": 2},
				{"id": "z", "lamport": 1},
				{"id": "a", "lamport": 2},
				{"id": "y", "lamport": 1}
			]
		},
		{
			"labels": ["z", "a"],
			"expectedOrder": ["z", "a"],
			"items": [
				{"id": "z", "lamport": 0},
				{"id": "a", "lamport": 1000000}
			]
		},
		{
			"labels": ["cmd_1", "cmdA", "cmd-1"],
			"expectedOrder": ["cmd-1", "cmdA", "cmd_1"],
			"items": [
				{"id": "cmd_1", "lamport": 3},
				{"id": "cmdA", "lamport": 3},
				{"id": "cmd-1", "lamport": 3}
			]
		},
		{
			"labels": ["9", "10", "2"],
			"expectedOrder": ["10", "2", "9"],
			"items": [
				{"id": "9", "lamport": 1},
				{"id": "10", "lamport": 1},
				{"id": "2", "lamport": 1}
			]
		}
	],
	"renderKeys": [
		{
			"labels": ["r3", "r1", "r2"],
			"expectedOrder": ["r1", "r2", "r3"],
			"items": [
