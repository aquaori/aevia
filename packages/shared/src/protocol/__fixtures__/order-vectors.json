				{"lamport": 4, "opId": "op-2", "sourceIndex": 0, "subIndex": 0}
			]
		},
		{
			"labels": ["op10", "op2", "op1"],
			"expectedOrder": ["op1", "op10", "op2"],
			"items": [
				{"lamport": 2, "opId": "op-10", "sourceIndex": 0, "subIndex": 0},
				{"lamport": 2, "opId": "op-2", "sourceIndex": 0, "subIndex": 0},
				{"lamport": 2, "opId": "op-1", "sourceIndex": 0, "subIndex": 0}
			]
		},
		{
			"labels": ["late-op-a", "early-op-z"],
			"expectedOrder": ["early-op-z", "late-op-a"],
			"items": [
