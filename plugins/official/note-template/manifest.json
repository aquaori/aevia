{
  "manifestVersion": 2,
  "apiVersion": 1,
  "id": "aevia.note-template",
  "name": "Note Template",
  "version": "1.0.0",
  "scope": "system",
  "main": "main.js",
  "permissions": [
    "scene.write",
    "ui.preview"
  ],
  "contributes": {
    "commands": [
      {
        "id": "insert",
        "label": "Insert Note",
        "resource": "assets/note.json",
        "shortcut": "Alt+Shift+5"
      }
    ]
  }
}
