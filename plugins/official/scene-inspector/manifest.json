{
  "manifestVersion": 2,
  "apiVersion": 1,
  "id": "aevia.scene-inspector",
  "name": "Scene Inspector",
  "version": "1.0.0",
  "scope": "user",
  "main": "main.js",
  "permissions": [
    "scene.read",
    "ui.preview"
  ],
  "contributes": {
    "commands": [
      {
        "id": "inspect",
        "label": "Inspect Scene",
        "shortcut": "Alt+Shift+1"
      }
    ]
  }
}
